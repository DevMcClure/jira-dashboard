# Copy to .env (git-ignored) and fill in your values. Nothing real belongs in this file.
# One .env at the repo root serves the server and the web app.
# Full list and meanings: docs/plan-backend.md → "Configuration template".

# --- Server (B1) ---------------------------------------------------------
# Interface and port the API listens on.
HOST=0.0.0.0
PORT=3000
# A sub-path if the app sits behind one (e.g. /dashboard); "/" for none.
BASE_PATH=/
# The URL(s) the web app is served from, comma-separated. Browsers elsewhere get no CORS access.
CORS_ORIGIN=http://localhost:5173
# fatal, error, warn, info, debug, trace or silent.
LOG_LEVEL=info

# --- MongoDB (B1) --------------------------------------------------------
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=jira_dashboard
# Path to a CA file, only if your Mongo uses TLS with a private CA.
MONGO_TLS_CA_FILE=
# Load the mock data into an empty database. Set to false once real data flows.
SEED_MOCK=true

# --- Web build (B1) ------------------------------------------------------
# static = the GitHub Pages demo (sample + uploads); api = read data from the server.
VITE_DATA_MODE=static
# Where the web app reaches the server's API.
VITE_API_BASE_URL=/api
