{
  "name": "@jira-dashboard/server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "The dashboard's API: Fastify + MongoDB, configured entirely through environment variables (see .env.example).",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "dev:api": "pnpm run dev",
    "build": "node build.mjs",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.3.1",
    "@fastify/rate-limit": "^11.2.1",
    "@jira-dashboard/core": "workspace:*",
    "date-fns": "^4.4.0",
    "fastify": "^5.12.7",
    "mongodb": "^7.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vitest": "^5.0.5"
  }
}
