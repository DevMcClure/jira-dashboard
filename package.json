{
  "name": "jira-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @jira-dashboard/web dev",
    "build": "pnpm -r --if-present typecheck && pnpm --filter @jira-dashboard/web build",
    "lint": "oxlint",
    "preview": "pnpm --filter @jira-dashboard/web preview",
    "test": "pnpm -r --if-present test",
    "mock:data": "pnpm --filter @jira-dashboard/web mock:data",
    "start": "pnpm install && pnpm run build && pnpm run preview"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "oxlint": "^1.88.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20.19"
  },
  "packageManager": "pnpm@10.34.7+sha512.ba98abc585539933375b5971f4bc6d6c73a1b4b7edc4a879e7d102fe5423d1e02309d67c60a11f04955093a96e521ad9c3b138cdd654ca5be563f378b3ae48bd",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
